---
import Wordmark from './Wordmark.astro';
import Cart from './Cart.astro';

const links = [
  { href: '/#families', label: 'Products' },
  { href: '/firmware/', label: 'Firmware' },
  { href: '/software/', label: 'Software' },
  { href: '/services/', label: 'Services' },
];
---
<nav id="site-nav" aria-label="Main" class="fixed w-full z-50 transition-all duration-300 bg-brand-bg/60 backdrop-blur-md py-6" data-nav>
  <div class="container mx-auto px-4 sm:px-6 flex justify-between items-center gap-4">
    <Wordmark />
    <div class="hidden lg:flex items-center gap-6 text-xs font-medium text-brand-text-muted uppercase tracking-wide">
      {links.map((l) => <a href={l.href} class="hover:text-white transition-colors">{l.label}</a>)}
      <a href="https://chrismoore.me" class="hover:text-white transition-colors bg-brand-surface-raised px-3 py-1 rounded-pill">Portfolio ↗</a>
      <Cart />
    </div>
    <div class="flex lg:hidden items-center gap-3">
      <Cart />
      <button type="button" class="text-white p-1" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>
      </button>
    </div>
  </div>
  <div id="mobile-menu" class="hidden lg:hidden glass-panel mt-4 px-4 py-4 flex-col gap-3 text-sm uppercase tracking-wide text-brand-text-muted" data-mobile-menu>
    {links.map((l) => <a href={l.href} class="py-2 hover:text-white">{l.label}</a>)}
    <a href="https://chrismoore.me" class="py-2 hover:text-white">Portfolio ↗</a>
  </div>
</nav>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  const onScroll = () => {
    if (!nav) return;
    const scrolled = window.scrollY > 50;
    nav.classList.toggle('glass-panel', scrolled);
    nav.classList.toggle('py-3', scrolled);
    nav.classList.toggle('py-6', !scrolled);
    nav.classList.toggle('bg-brand-bg/60', !scrolled);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    menu?.classList.toggle('flex', open);
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
