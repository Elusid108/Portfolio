---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';

interface Props { releases: CollectionEntry<'firmware'>[] }
const { releases } = Astro.props;
const rendered = await Promise.all(releases.map(async (r) => ({ r, Content: (await render(r)).Content })));
---
<ol class="space-y-6">
  {rendered.map(({ r, Content }) => (
    <li class="rounded-xl bg-brand-surface border border-brand-border p-5">
      <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
        <h3 class="font-bold">{r.data.name}</h3>
        <span class="font-mono text-brand-accent text-sm">v{r.data.version}</span>
        <time class="font-mono text-xs text-brand-text-muted" datetime={r.data.date.toISOString()}>{r.data.date.toISOString().slice(0, 10)}</time>
        {r.data.ota && <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded bg-brand-secondary-strong text-white">OTA</span>}
      </div>
      <div class="mt-1 flex flex-wrap gap-2">
        {r.data.targets.map((t) => <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded bg-brand-surface-raised text-brand-accent border border-cyan-500/30">{t}</span>)}
      </div>
      <div class="prose-sm mt-3 text-brand-text-muted [&_ul]:list-disc [&_ul]:pl-5 [&_li]:my-0.5"><Content /></div>
      <div class="mt-4 flex flex-wrap gap-4 text-xs uppercase tracking-wide font-medium">
        {r.data.webInstallerManifest && <a class="text-brand-accent hover:underline" href={r.data.webInstallerManifest}>Flash via web installer</a>}
        {r.data.downloadUrl && <a class="text-brand-text-muted hover:text-white" href={r.data.downloadUrl} rel="noopener">Download</a>}
        {r.data.repo && <a class="text-brand-text-muted hover:text-white" href={r.data.repo} rel="noopener">Source</a>}
      </div>
      {r.data.sha256 && <p class="mt-2 font-mono text-[10px] text-brand-text-subtle break-all">sha256 {r.data.sha256}</p>}
    </li>
  ))}
</ol>
