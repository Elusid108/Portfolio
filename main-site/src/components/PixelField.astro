---
// Vanilla port of the portfolio's PixelField hero canvas (Portfolio Template.html,
// PixelField component). Same constants so both heroes animate identically.
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<canvas data-pixel-field aria-hidden="true" class={`pointer-events-none ${cls}`}></canvas>

<script>
  const PITCH = 18;
  const SPOT_RADIUS = 220;
  const FRAME_MS = 1000 / 30;

  document.querySelectorAll<HTMLCanvasElement>('[data-pixel-field]').forEach((canvas) => {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let width = 0, height = 0, cols = 0, rows = 0;
    let raf = 0, lastFrame = 0, onScreen = true;
    const pointer = { x: 0, y: 0, tx: 0, ty: 0, lastMove: -Infinity };

    const draw = (t: number) => {
      const idle = t - pointer.lastMove > 2500;
      if (idle) {
        pointer.tx = width * (0.5 + 0.42 * Math.sin(t * 0.00023));
        pointer.ty = height * (0.5 + 0.36 * Math.sin(t * 0.00031 + 1.3));
      }
      pointer.x += (pointer.tx - pointer.x) * (still ? 1 : 0.12);
      pointer.y += (pointer.ty - pointer.y) * (still ? 1 : 0.12);

      ctx.clearRect(0, 0, width, height);
      const offset = PITCH / 2;
      for (let j = 0; j < rows; j++) {
        const cy = j * PITCH + offset;
        const dy = cy - pointer.y;
        for (let i = 0; i < cols; i++) {
          const cx = i * PITCH + offset;
          const plasma = (Math.sin(i * 0.17 + t * 0.0007) + Math.sin(j * 0.21 - t * 0.0005) + Math.sin((i + j) * 0.11 + t * 0.0004)) / 3;
          const dx = cx - pointer.x;
          const d = Math.sqrt(dx * dx + dy * dy);
          const spot = d < SPOT_RADIUS ? Math.pow(1 - d / SPOT_RADIUS, 2) : 0;
          const level = 0.1 + 0.14 * (plasma + 1) + spot * 0.9;
          const hue = Math.round(232 + 43 * plasma - 40 * spot);
          const size = 2.5 + spot * 3.5;
          ctx.fillStyle = `hsla(${hue}, 90%, ${55 + spot * 20}%, ${level.toFixed(2)})`;
          ctx.fillRect(cx - size / 2, cy - size / 2, size, size);
        }
      }
    };

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      width = rect.width; height = rect.height;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      cols = Math.ceil(width / PITCH);
      rows = Math.ceil(height / PITCH);
      if (still) draw(0);
    };

    const loop = (t: number) => {
      raf = requestAnimationFrame(loop);
      if (t - lastFrame < FRAME_MS) return;
      lastFrame = t;
      draw(t);
    };
    const start = () => { if (!still && !raf && onScreen && !document.hidden) raf = requestAnimationFrame(loop); };
    const stop = () => { cancelAnimationFrame(raf); raf = 0; };

    resize();
    pointer.x = pointer.tx = width * 0.7;
    pointer.y = pointer.ty = height * 0.5;

    window.addEventListener('resize', resize);
    window.addEventListener('load', resize);
    window.addEventListener('pointermove', (e) => {
      const rect = canvas.getBoundingClientRect();
      pointer.tx = e.clientX - rect.left;
      pointer.ty = e.clientY - rect.top;
      pointer.lastMove = performance.now();
    }, { passive: true });
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    new IntersectionObserver(([entry]) => { onScreen = entry.isIntersecting; onScreen ? start() : stop(); }).observe(canvas);
    start();
  });
</script>
