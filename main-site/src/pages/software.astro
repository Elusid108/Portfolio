---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
const apps = await getCollection('software');
---
<Base title="Software" description="Desktop and web apps that go with Chris Moore Designs hardware.">
  <section class="pt-32 pb-20 container mx-auto px-4 sm:px-6 max-w-4xl">
    <p class="font-mono text-xs uppercase tracking-widest text-brand-accent mb-2">Software</p>
    <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-10">Apps</h1>
    <div class="grid md:grid-cols-2 gap-6">
      {apps.map((s) => (
        <div class="rounded-xl bg-brand-surface border border-brand-border p-6">
          <h2 class="text-xl font-bold">{s.data.name} {s.data.version && <span class="font-mono text-brand-accent text-sm">v{s.data.version}</span>}</h2>
          <p class="text-sm text-brand-text-muted mt-2">{s.data.summary}</p>
          <div class="mt-3 flex flex-wrap gap-2">{s.data.platforms.map((p) => <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded bg-brand-surface-raised text-brand-text-muted">{p}</span>)}</div>
          <div class="mt-4 flex flex-wrap gap-4 text-xs uppercase tracking-wide font-medium">
            {s.data.appUrl && <a class="text-brand-accent hover:underline" href={s.data.appUrl} rel="noopener">Launch ↗</a>}
            {s.data.releaseUrl && <a class="text-brand-text-muted hover:text-white" href={s.data.releaseUrl} rel="noopener">Download</a>}
            {s.data.repo && <a class="text-brand-text-muted hover:text-white" href={s.data.repo} rel="noopener">Source</a>}
          </div>
        </div>
      ))}
    </div>
  </section>
</Base>
