---
import { getCollection, getEntry, getEntries, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AddToCart from '../../components/AddToCart.astro';
import SpecTable from '../../components/SpecTable.astro';
import ReleaseList from '../../components/ReleaseList.astro';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((p) => ({ params: { slug: p.id }, props: { product: p } }));
}
const { product } = Astro.props;
const { Content } = await render(product);
const family = await getEntry(product.data.family);
const firmware = await getEntries(product.data.firmware);
const software = await getEntries(product.data.software);
---
<Base title={product.data.name} description={product.data.summary}>
  <article class="pt-32 pb-20 container mx-auto px-4 sm:px-6 grid lg:grid-cols-3 gap-10">
    <div class="lg:col-span-2 space-y-8">
      <div>
        <a href={`/families/${family!.id}/`} class="font-mono text-xs uppercase tracking-widest text-brand-accent hover:underline">{family!.data.name}</a>
        <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight mt-2">{product.data.name}</h1>
        <p class="text-brand-text-muted text-lg mt-4">{product.data.summary}</p>
      </div>
      <div class="aspect-video rounded-2xl bg-gradient-to-br from-brand-surface to-black border border-brand-border flex items-center justify-center text-brand-text-subtle font-mono text-sm">product image</div>
      <div class="text-brand-text-muted"><Content /></div>
      {firmware.length > 0 && (
        <section>
          <h2 class="text-2xl font-bold mb-4">Firmware</h2>
          <ReleaseList releases={firmware} />
        </section>
      )}
      {software.length > 0 && (
        <section>
          <h2 class="text-2xl font-bold mb-4">Software</h2>
          <ul class="space-y-2">{software.map((s) => <li><a href="/software/" class="text-brand-accent hover:underline">{s.data.name}</a> <span class="text-brand-text-muted text-sm">— {s.data.summary}</span></li>)}</ul>
        </section>
      )}
    </div>
    <aside class="space-y-6 lg:sticky lg:top-28 self-start">
      <div class="rounded-xl bg-brand-surface/50 border border-brand-border p-6">
        <p class="font-mono text-xs uppercase tracking-widest text-brand-text-muted">SKU {product.data.sku}</p>
        <AddToCart handle={product.data.shopifyHandle} placeholderPrice={product.data.placeholderPrice} class="mt-4" />
      </div>
      <div class="rounded-xl bg-brand-surface/50 border border-brand-border p-6">
        <h2 class="font-bold mb-3">Specifications</h2>
        <SpecTable specs={product.data.specs} />
      </div>
    </aside>
  </article>
</Base>
