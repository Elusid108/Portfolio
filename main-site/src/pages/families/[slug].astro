---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AddToCart from '../../components/AddToCart.astro';

export async function getStaticPaths() {
  const families = await getCollection('families');
  return families.map((f) => ({ params: { slug: f.id }, props: { family: f } }));
}
const { family } = Astro.props;
const { Content } = await render(family);
const products = (await getCollection('products', (p) => p.data.family.id === family.id)).sort((a, b) => a.data.order - b.data.order);
---
<Base title={family.data.name} description={family.data.tagline}>
  <section class="pt-32 pb-12 container mx-auto px-4 sm:px-6 max-w-4xl">
    <p class="font-mono text-xs uppercase tracking-widest text-brand-accent mb-2">{family.data.category}</p>
    <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight">{family.data.name}</h1>
    <p class="text-brand-text-muted text-lg mt-4">{family.data.tagline}</p>
    <div class="mt-6 text-brand-text-muted"><Content /></div>
    {family.data.portfolioSlug && (
      <a class="mt-4 inline-block text-xs uppercase tracking-wide text-brand-accent hover:underline" href={`https://chrismoore.me/projects/${family.data.portfolioSlug}/`}>See it in the portfolio ↗</a>
    )}
  </section>
  <section class="py-12 container mx-auto px-4 sm:px-6 max-w-4xl grid md:grid-cols-2 gap-6">
    {products.map((p) => (
      <div class="rounded-xl bg-brand-surface border border-brand-border p-6 flex flex-col gap-3">
        <a href={`/products/${p.id}/`} class="text-2xl font-bold hover:text-brand-accent">{p.data.name}</a>
        <p class="text-sm text-brand-text-muted">{p.data.summary}</p>
        <AddToCart handle={p.data.shopifyHandle} placeholderPrice={p.data.placeholderPrice} class="mt-auto pt-2" />
      </div>
    ))}
  </section>
</Base>
