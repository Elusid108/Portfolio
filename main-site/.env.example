# Copy to .env for local dev. In CI these come from repository secrets/variables.
#
# PUBLIC_* variables are inlined into the client bundle by Astro. That is
# intended: the Storefront API token is a *public* token by design (it can
# only read products/collections and create carts). Never put an Admin API
# token here or anywhere else in this repo.

# Your store's myshopify domain, e.g. chris-moore-designs.myshopify.com
PUBLIC_SHOPIFY_DOMAIN=

# Storefront API access token (public, unauthenticated scopes only)
PUBLIC_SHOPIFY_STOREFRONT_TOKEN=

# Storefront API version to pin, e.g. 2026-07
PUBLIC_SHOPIFY_API_VERSION=2026-07
